{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in the DZ Restrooms application",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "isAdmin": { "type": "boolean", "description": "Whether the user has administrator privileges" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when user profile was created" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "User bookmarked restroom facility",
      "type": "object",
      "properties": {
        "restroomId": { "type": "string", "description": "ID of the saved restroom" },
        "addedAt": { "type": "string", "format": "date-time", "description": "Timestamp when restroom was saved" }
      },
      "required": ["restroomId", "addedAt"]
    },
    "Restroom": {
      "title": "Restroom",
      "description": "Restroom facility details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "name": { "type": "string", "description": "Name of restroom in French or common name" },
        "nameAr": { "type": "string", "description": "Arabic name of the facility" },
        "latitude": { "type": "number", "description": "GPS latitude" },
        "longitude": { "type": "number", "description": "GPS longitude" },
        "province": { "type": "string", "description": "Wilaya name in Algeria" },
        "address": { "type": "string", "description": "Street or landmark address" },
        "type": { "type": "string", "description": "Facility type (public, private, mosque, mall, station)" },
        "isFree": { "type": "boolean", "description": "Whether the facility is free" },
        "priceDzd": { "type": "number", "description": "Price in Algerian Dinars if paid" },
        "hasWater": { "type": "boolean", "description": "Running water available" },
        "hasSoap": { "type": "boolean", "description": "Soap available" },
        "hasPaper": { "type": "boolean", "description": "Toilet paper available" },
        "hasAccessibleToilet": { "type": "boolean", "description": "Wheelchair accessible" },
        "hasSquatToilet": { "type": "boolean", "description": "Traditional squat toilet" },
        "hasSittingToilet": { "type": "boolean", "description": "Western sitting toilet" },
        "rating": { "type": "number", "description": "Average rating out of 5" },
        "reviewsCount": { "type": "number", "description": "Total reviews count" },
        "cleanlinessRating": { "type": "number", "description": "Average cleanliness rating" },
        "donationCcp": { "type": "string", "description": "Donation CCP reference if configured" },
        "createdBy": { "type": "string", "description": "User ID of creator" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "latitude", "longitude", "province", "createdBy", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Community user review and cleanliness rating",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Review unique identifier" },
        "restroomId": { "type": "string", "description": "Target restroom document ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "rating": { "type": "number", "description": "Overall rating 1.0 to 5.0" },
        "cleanlinessRating": { "type": "number", "description": "Cleanliness rating 1.0 to 5.0" },
        "comment": { "type": "string", "description": "Text review comments" },
        "hasWaterAvailable": { "type": "boolean", "description": "Water was available" },
        "hasSoapPaper": { "type": "boolean", "description": "Soap/paper was available" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Review submission timestamp" }
      },
      "required": ["id", "restroomId", "userId", "authorName", "rating", "cleanlinessRating", "createdAt"]
    },
    "MosqueDonationAccount": {
      "title": "MosqueDonationAccount",
      "description": "Unverified mosque donation account record kept strictly for review by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique deterministic account record ID preventing duplicates" },
        "mosque_name": { "type": "string", "description": "Official or known mosque name" },
        "location_description": { "type": "string", "description": "Neighborhood, city, and wilaya description" },
        "ccp": { "type": "string", "description": "CCP account number preserved strictly as string with leading zeros" },
        "account_key": { "type": "string", "description": "CCP account key preserved strictly as string" },
        "rip": { "type": "string", "description": "RIP identifier preserved strictly as string with leading zeros (or null)" },
        "source": { "type": "string", "description": "Online source reference link (e.g. Mawaqit)" },
        "account_holder_name": { "type": "string", "description": "Beneficiary legal name once confirmed, initially null" },
        "source_checked_at": { "type": "string", "description": "Date when source was checked (YYYY-MM-DD)" },
        "verification_status": { "type": "string", "description": "Status: pending, under_review, verified, rejected" },
        "donations_enabled": { "type": "boolean", "description": "Safety gate: donations enabled only after full verification, initially false" },
        "verified_at": { "type": "string", "format": "date-time", "description": "Timestamp of formal verification, initially null" },
        "committee_consent_confirmed": { "type": "boolean", "description": "Confirmation of mosque committee written consent" },
        "document_name": { "type": "string", "description": "Attached bank or CCP document filename or reference" },
        "document_attached_at": { "type": "string", "format": "date-time", "description": "Timestamp when document was recorded" },
        "admin_notes": { "type": "string", "description": "Auditor notes on status and checks" },
        "created_at": { "type": "string", "format": "date-time", "description": "Record creation timestamp" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last audit update timestamp" }
      },
      "required": [
        "id",
        "mosque_name",
        "ccp",
        "account_key",
        "source",
        "source_checked_at",
        "verification_status",
        "donations_enabled"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/favorites/{restroomId}": {
      "schema": { "$ref": "#/entities/UserFavorite" },
      "description": "Bookmarked favorite restrooms for the user"
    },
    "/restrooms/{restroomId}": {
      "schema": { "$ref": "#/entities/Restroom" },
      "description": "Algerian restrooms registry"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Community reviews and cleanliness ratings"
    },
    "/mosque_donation_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/MosqueDonationAccount" },
      "description": "Mosque donation accounts under review by administrators"
    }
  }
}
